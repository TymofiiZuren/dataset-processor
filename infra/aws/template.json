{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Dataset Processor AWS storage/queue foundation. No compute, database, deployment pipeline or credentials. Review before provisioning.",
  "Parameters": {
    "ResourcePrefix": {"Type": "String", "AllowedPattern": "^[a-z][a-z0-9-]{2,23}$", "Description": "Unique lowercase application prefix (3-24 characters)."}
  },
  "Resources": {
    "DataBucket": {
      "Type": "AWS::S3::Bucket", "DeletionPolicy": "Retain", "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": {"Fn::Sub": "${ResourcePrefix}-${AWS::AccountId}-${AWS::Region}"},
        "VersioningConfiguration": {"Status": "Enabled"},
        "PublicAccessBlockConfiguration": {"BlockPublicAcls": true, "IgnorePublicAcls": true, "BlockPublicPolicy": true, "RestrictPublicBuckets": true},
        "OwnershipControls": {"Rules": [{"ObjectOwnership": "BucketOwnerEnforced"}]},
        "BucketEncryption": {"ServerSideEncryptionConfiguration": [{"ServerSideEncryptionByDefault": {"SSEAlgorithm": "AES256"}}]}
      }
    },
    "BucketTransportPolicy": {
      "Type": "AWS::S3::BucketPolicy", "DeletionPolicy": "Retain", "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Bucket": {"Ref": "DataBucket"},
        "PolicyDocument": {"Version": "2012-10-17", "Statement": [{"Effect": "Deny", "Principal": "*", "Action": "s3:*", "Resource": [{"Fn::GetAtt": ["DataBucket", "Arn"]}, {"Fn::Sub": "${DataBucket.Arn}/*"}], "Condition": {"Bool": {"aws:SecureTransport": "false"}}}]}
      }
    },
    "DeadLetterQueue": {
      "Type": "AWS::SQS::Queue", "DeletionPolicy": "Retain", "UpdateReplacePolicy": "Retain",
      "Properties": {
        "QueueName": {"Fn::Sub": "${ResourcePrefix}-dead"}, "SqsManagedSseEnabled": true, "MessageRetentionPeriod": 1209600,
        "RedriveAllowPolicy": {"redrivePermission": "byQueue", "sourceQueueArns": [{"Fn::Sub": "arn:${AWS::Partition}:sqs:${AWS::Region}:${AWS::AccountId}:${ResourcePrefix}-work"}]}
      }
    },
    "WorkQueue": {
      "Type": "AWS::SQS::Queue", "DeletionPolicy": "Retain", "UpdateReplacePolicy": "Retain",
      "Properties": {
        "QueueName": {"Fn::Sub": "${ResourcePrefix}-work"}, "SqsManagedSseEnabled": true, "VisibilityTimeout": 90, "ReceiveMessageWaitTimeSeconds": 2, "MessageRetentionPeriod": 345600,
        "RedrivePolicy": {"deadLetterTargetArn": {"Fn::GetAtt": ["DeadLetterQueue", "Arn"]}, "maxReceiveCount": 20}
      }
    },
    "QueueTransportPolicy": {
      "Type": "AWS::SQS::QueuePolicy", "DeletionPolicy": "Retain", "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Queues": [{"Ref": "WorkQueue"}, {"Ref": "DeadLetterQueue"}],
        "PolicyDocument": {"Version": "2012-10-17", "Statement": [{"Effect": "Deny", "Principal": "*", "Action": "sqs:*", "Resource": [{"Fn::GetAtt": ["WorkQueue", "Arn"]}, {"Fn::GetAtt": ["DeadLetterQueue", "Arn"]}], "Condition": {"Bool": {"aws:SecureTransport": "false"}}}]}
      }
    },
    "ApiPolicy": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Properties": {"Description": "Attach only to the processor API workload identity.", "PolicyDocument": {"Version": "2012-10-17", "Statement": [
        {"Effect": "Allow", "Action": ["s3:ListBucket", "s3:GetBucketVersioning", "s3:GetBucketPublicAccessBlock", "s3:GetEncryptionConfiguration", "s3:GetBucketOwnershipControls", "s3:GetLifecycleConfiguration"], "Resource": {"Fn::GetAtt": ["DataBucket", "Arn"]}},
        {"Effect": "Allow", "Action": ["s3:GetObject", "s3:GetObjectVersion"], "Resource": {"Fn::Sub": "${DataBucket.Arn}/jobs/*"}},
        {"Effect": "Allow", "Action": ["s3:PutObject"], "Resource": {"Fn::Sub": "${DataBucket.Arn}/jobs/*"}, "Condition": {"StringEquals": {"s3:x-amz-server-side-encryption": "AES256"}}},
        {"Effect": "Allow", "Action": ["sqs:GetQueueAttributes"], "Resource": [{"Fn::GetAtt": ["WorkQueue", "Arn"]}, {"Fn::GetAtt": ["DeadLetterQueue", "Arn"]}]}
      ]}}
    },
    "CoordinatorPolicy": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Properties": {"Description": "Attach only to the processor coordinator workload identity.", "PolicyDocument": {"Version": "2012-10-17", "Statement": [
        {"Effect": "Allow", "Action": ["s3:ListBucket", "s3:GetBucketVersioning", "s3:GetBucketPublicAccessBlock", "s3:GetEncryptionConfiguration", "s3:GetBucketOwnershipControls", "s3:GetLifecycleConfiguration"], "Resource": {"Fn::GetAtt": ["DataBucket", "Arn"]}},
        {"Effect": "Allow", "Action": ["s3:GetObject", "s3:GetObjectVersion"], "Resource": {"Fn::Sub": "${DataBucket.Arn}/jobs/*"}},
        {"Effect": "Allow", "Action": ["s3:PutObject"], "Resource": {"Fn::Sub": "${DataBucket.Arn}/jobs/*"}, "Condition": {"StringEquals": {"s3:x-amz-server-side-encryption": "AES256"}}},
        {"Effect": "Allow", "Action": ["sqs:SendMessage"], "Resource": {"Fn::GetAtt": ["WorkQueue", "Arn"]}},
        {"Effect": "Allow", "Action": ["sqs:GetQueueAttributes"], "Resource": [{"Fn::GetAtt": ["WorkQueue", "Arn"]}, {"Fn::GetAtt": ["DeadLetterQueue", "Arn"]}]}
      ]}}
    },
    "WorkerPolicy": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Properties": {"Description": "Attach only to processor worker workload identities.", "PolicyDocument": {"Version": "2012-10-17", "Statement": [
        {"Effect": "Allow", "Action": ["s3:ListBucket", "s3:GetBucketVersioning", "s3:GetBucketPublicAccessBlock", "s3:GetEncryptionConfiguration", "s3:GetBucketOwnershipControls", "s3:GetLifecycleConfiguration"], "Resource": {"Fn::GetAtt": ["DataBucket", "Arn"]}},
        {"Effect": "Allow", "Action": ["s3:GetObjectVersion"], "Resource": {"Fn::Sub": "${DataBucket.Arn}/jobs/*"}},
        {"Effect": "Allow", "Action": ["s3:PutObject"], "Resource": {"Fn::Sub": "${DataBucket.Arn}/jobs/*"}, "Condition": {"StringEquals": {"s3:x-amz-server-side-encryption": "AES256"}}},
        {"Effect": "Allow", "Action": ["sqs:ReceiveMessage", "sqs:DeleteMessage", "sqs:ChangeMessageVisibility"], "Resource": {"Fn::GetAtt": ["WorkQueue", "Arn"]}},
        {"Effect": "Allow", "Action": ["sqs:GetQueueAttributes"], "Resource": [{"Fn::GetAtt": ["WorkQueue", "Arn"]}, {"Fn::GetAtt": ["DeadLetterQueue", "Arn"]}]}
      ]}}
    }
  },
  "Outputs": {
    "AccountId": {"Value": {"Ref": "AWS::AccountId"}},
    "Region": {"Value": {"Ref": "AWS::Region"}},
    "BucketName": {"Value": {"Ref": "DataBucket"}},
    "QueueUrl": {"Value": {"Ref": "WorkQueue"}},
    "DeadLetterQueueArn": {"Value": {"Fn::GetAtt": ["DeadLetterQueue", "Arn"]}},
    "ApiPolicyArn": {"Value": {"Ref": "ApiPolicy"}},
    "CoordinatorPolicyArn": {"Value": {"Ref": "CoordinatorPolicy"}},
    "WorkerPolicyArn": {"Value": {"Ref": "WorkerPolicy"}}
  }
}
